# Vorlage für eine einzelne Umgebung. Für den lokalen Dev-Server/Ingest nach
# .env.local kopieren; für eine zweite, von Production getrennte Umgebung
# (z.B. zum gefahrlosen Testen von Schema-Änderungen) nach .env.dev kopieren
# und dort auf eine eigene DB zeigen lassen — die :dev-npm-Skripte
# (db:setup:dev, db:ingest:dev, …) nutzen automatisch .env.dev statt
# .env.local. Beide Dateinamen sind über .gitignores ".env*"-Regel bereits
# von Git ausgeschlossen. Siehe README, Abschnitt "Dev-/Preview-Umgebung".

# ── Datenbank ────────────────────────────────────────────────────────
# Verbindung der App (läuft über pgBouncer / Transaction-Mode).
DATABASE_URL="postgres://user:password@host:5432/datenbank"
# Direkte Postgres-Verbindung für den Ingest (umgeht pgBouncer). Optional —
# fehlt sie, nutzt der Ingest DATABASE_URL.
DIRECT_DATABASE_URL="postgres://user:password@host:5432/datenbank"

# ── Ingest ───────────────────────────────────────────────────────────
# Pfad zum Markdown-Vault (Ordner Charaktere/, Missionen/, Archiv/ …).
VAULT_PATH="/pfad/zum/vault"

# ── Cache-Revalidation nach dem Ingest ───────────────────────────────
# Ziel(e) für den /api/revalidate-Aufruf. Darf eine KOMMASEPARIERTE LISTE
# sein — so invalidiert ein lokaler Ingest sowohl Produktion als auch den
# laufenden Dev-Server. Ohne den localhost-Eintrag bleibt dessen
# unstable_cache nach dem Import stale (zeigt alte/leere Daten).
#   Nur Produktion:   SITE_URL="https://neo-archiv.de"
#   Prod + lokal:     SITE_URL="https://neo-archiv.de, http://localhost:3000"
SITE_URL="http://localhost:3000"

# Shared Secret für /api/revalidate. Muss auf jedem Ziel-Server identisch
# gesetzt sein (lokal hier, in Produktion in den Deploy-Env-Variablen).
REVALIDATE_SECRET="ein-langes-zufaelliges-secret"

# ── Login (/login) ───────────────────────────────────────────────────
# Signiert das Session-Cookie (src/lib/session.ts). Erzeugen z.B. mit:
#   openssl rand -base64 32
SESSION_SECRET="ein-langes-zufaelliges-secret"

# ── Vault-Schreibpfad (src/lib/githubVault.ts) ───────────────────────
# Fine-grained Personal Access Token mit Contents-Schreibrecht NUR auf das
# Vault-Repo. Wird server-seitig für Web-App-Content-Erstellung genutzt
# (siehe docs/content-creation-strategy.md) — niemals im Client-Bundle.
GITHUB_VAULT_TOKEN=""
# "<owner>/<repo>" des Vault-Repos.
GITHUB_VAULT_REPO=""
# Ziel-Branch für Commits aus der App.
GITHUB_VAULT_BRANCH="main"

# ── Aktivierungs-Mail (src/lib/mail.ts) ──────────────────────────────
# API-Key von https://resend.com (Dashboard → API Keys). Ohne gesetzten
# Key schlägt der Mail-Versand fehl — der GM sieht dann in der
# Nutzerverwaltung stattdessen den Aktivierungslink zum manuellen
# Weitergeben, das Anlegen des Users funktioniert trotzdem.
RESEND_API_KEY=""
# Absenderadresse. Ohne eigene, bei Resend verifizierte Domain funktioniert
# nur der Resend-Test-Absender (kann dann nur an die eigene, bei Resend
# registrierte E-Mail-Adresse senden).
RESEND_FROM_EMAIL="Neo Archive <onboarding@resend.dev>"

# Vorlage für .env.local (lokal) bzw. die Umgebungsvariablen des Deployments.
# Kopieren, ausfüllen, NICHT einchecken — .env.local ist in .gitignore.
#
# Aufgeführt ist alles, was der Code tatsächlich liest — direkt über
# process.env oder über requireEnv() (src/lib/r2Backup.ts).
# Pflicht sind nur DATABASE_URL und SESSION_SECRET; jeder optionale Block
# schaltet still die jeweilige Funktion ab, wenn er fehlt (kein Absturz).

# ─────────────────────────────────────────────────────────────────────
# Pflicht
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL-Verbindung. Die App verbindet über pgBouncer im
# Transaction-Mode (siehe src/lib/db.ts).
DATABASE_URL="postgres://user:password@host:5432/datenbank"

# Signiert das Session-Cookie (HMAC, src/lib/sessionToken.ts). Ein langer
# Zufallswert; wird er geändert, sind alle bestehenden Sitzungen ungültig.
#   openssl rand -base64 48
SESSION_SECRET=""

# ─────────────────────────────────────────────────────────────────────
# Datenbank — optional
# ─────────────────────────────────────────────────────────────────────

# Verschlüsselung zur Datenbank. Ohne diese Variable entscheidet das
# `sslmode` der DATABASE_URL (kein sslmode ⇒ unverschlüsselt). Läuft die
# Datenbank NICHT im selben privaten Netz wie die App, gehört
# `?sslmode=require` an die DATABASE_URL oder hier "require" gesetzt —
# sonst laufen auch die Passwort-Hashes im Klartext über die Leitung.
#   require = verschlüsseln, Zertifikat nicht gegen eine CA prüfen
#   false   = Klartext erzwingen (lokale Entwicklung, privates Netz)
# DB_SSL="require"

# Verbindungen im Pool (Default 5). Nur senken, wenn pgBouncer/Postgres
# eine engere Grenze hat.
# DB_POOL_MAX="5"

# Direkte Verbindung an pgBouncer vorbei — für Wartungsskripte, die
# Prepared Statements oder Session-Features brauchen.
# DIRECT_DATABASE_URL=""

# ─────────────────────────────────────────────────────────────────────
# Ingest und Cache-Invalidierung
# ─────────────────────────────────────────────────────────────────────

# Pfad zum Markdown-Vault (Ordner Charaktere/, Missionen/ …) für db:ingest.
VAULT_PATH="/pfad/zum/vault"

# Ziel(e) für POST /api/revalidate am Ende des Ingests. Darf eine
# KOMMASEPARIERTE Liste sein — den lokalen Dev-Server mit aufnehmen, sonst
# zeigt er nach dem Import veraltete Daten.
SITE_URL="http://localhost:3000"

# Muss auf jedem in SITE_URL genannten Server identisch gesetzt sein.
REVALIDATE_SECRET="ein-langes-zufaelliges-secret"

# ─────────────────────────────────────────────────────────────────────
# Ersten Admin anlegen (npm run db:create-admin)
# ─────────────────────────────────────────────────────────────────────

# ADMIN_EMAIL=""
# ADMIN_NAME=""
# ADMIN_PASSWORD=""     # ohne: das Konto bekommt einen Aktivierungslink

# ─────────────────────────────────────────────────────────────────────
# Datenbank-Assistent (RAG) — optional, ohne Schlüssel ist /rag aus
# ─────────────────────────────────────────────────────────────────────

# Embeddings (text-embedding-3-small, 1536 Dimensionen).
OPENAI_API_KEY=""

# Optional: Admin-Key (sk-admin-…) für das Nutzungs-Panel unter /admin/rag
# (Costs-API). Fehlt er, wird OPENAI_API_KEY versucht.
# OPENAI_ADMIN_API_KEY=""

# Workers AI erzeugt die Antwort; die Account-ID wird aus R2_ACCOUNT_ID
# wiederverwendet.
CLOUDFLARE_AI_API_TOKEN=""
# CLOUDFLARE_AI_MODEL=""   # Default: @cf/meta/llama-3.3-70b-instruct-fp8-fast

# ─────────────────────────────────────────────────────────────────────
# Cloudflare R2 — optional (Bild-Uploads, Portraits, Backups)
# ─────────────────────────────────────────────────────────────────────

# CLOUDFLARE_ACCOUNT_ID=""
# R2_ACCOUNT_ID=""
# Zugangsdaten des R2-API-Tokens (Object Read & Write). Bedienen beide
# Buckets — den Backup- und den Asset-Bucket.
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# Backup-Bucket: DB- und Nutzer-Backups (src/lib/r2Backup.ts).
# R2_BUCKET_NAME=""
# Asset-Bucket: hochgeladene Bilder, Portraits, Charakterbögen.
# R2_ASSET_BUCKET_NAME=""
# Auslieferungs-Domain des Asset-Buckets, NICHT der Bucketname
# (z.B. https://assets.example.de) — siehe src/lib/assetStorage.ts.
# R2_ASSET_PUBLIC_BASE_URL=""

# ─────────────────────────────────────────────────────────────────────
# E-Mail (Resend) — optional, ohne Schlüssel wird nichts verschickt
# ─────────────────────────────────────────────────────────────────────

# RESEND_API_KEY=""
# RESEND_FROM_EMAIL=""

# ─────────────────────────────────────────────────────────────────────
# Web-Push — optional; Schlüsselpaar erzeugen mit `npx web-push generate-vapid-keys`
# ─────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""   # identisch mit VAPID_PUBLIC_KEY
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT=""                  # mailto:…-Adresse

# ─────────────────────────────────────────────────────────────────────
# Sonstiges
# ─────────────────────────────────────────────────────────────────────

# Basis-URL für absolute Links außerhalb eines Requests (Mails, Skripte).
# Im Request wird der Host-Header benutzt, siehe src/lib/http.ts.
# NEXT_PUBLIC_BASE_URL=""

# Nur für die E2E-Tests: eigener Chromium-Pfad statt des von Playwright
# heruntergeladenen Browsers.
# PLAYWRIGHT_CHROMIUM_PATH=""

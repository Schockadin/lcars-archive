    "db:revalidate": "tsx --env-file=.env.local scripts/ingest/index.ts revalidate",
    "db:reset": "tsx --env-file=.env.local scripts/reset-db.ts",
    "db:seed-dialogue": "tsx --env-file=.env.local scripts/seedExampleDialogue.ts",

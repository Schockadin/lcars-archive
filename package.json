{
  "name": "lcars-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:setup": "tsx --env-file=.env.local scripts/setup-db.ts",
    "db:ingest": "tsx --env-file=.env.local scripts/ingest/index.ts",
    "db:ingest:new": "tsx --env-file=.env.local scripts/ingest/ingestNew.ts",
    "db:characters": "tsx --env-file=.env.local scripts/ingest/index.ts characters",
    "db:missions": "tsx --env-file=.env.local scripts/ingest/index.ts missions",
    "db:archive": "tsx --env-file=.env.local scripts/ingest/index.ts archive",
    "db:revalidate": "tsx --env-file=.env.local scripts/ingest/index.ts revalidate",
    "db:reset": "tsx --env-file=.env.local scripts/reset-db.ts",
    "db:seed-dialogue": "tsx --env-file=.env.local scripts/seedExampleDialogue.ts",
    "db:create-admin": "tsx --conditions=react-server --env-file=.env.local scripts/create-initial-admin.ts",
    "db:setup:dev": "tsx --env-file=.env.development.local scripts/setup-db.ts",
    "db:ingest:dev": "tsx --env-file=.env.development.local scripts/ingest/index.ts",
    "db:ingest:new:dev": "tsx --env-file=.env.development.local scripts/ingest/ingestNew.ts",
    "db:characters:dev": "tsx --env-file=.env.development.local scripts/ingest/index.ts characters",
    "db:missions:dev": "tsx --env-file=.env.development.local scripts/ingest/index.ts missions",
    "db:archive:dev": "tsx --env-file=.env.development.local scripts/ingest/index.ts archive",
    "db:revalidate:dev": "tsx --env-file=.env.development.local scripts/ingest/index.ts revalidate",
    "db:reset:dev": "tsx --env-file=.env.development.local scripts/reset-db.ts",
    "db:seed-dialogue:dev": "tsx --env-file=.env.development.local scripts/seedExampleDialogue.ts",
    "db:create-admin:dev": "tsx --conditions=react-server --env-file=.env.development.local scripts/create-initial-admin.ts",
    "embed:all": "tsx --env-file=.env.local scripts/embed-all.ts",
    "embed:all:dev": "tsx --env-file=.env.development.local scripts/embed-all.ts",
    "db:backup": "tsx --conditions=react-server scripts/backup-db.ts",
    "db:backup:cleanup": "tsx --conditions=react-server scripts/cleanup-db-backups.ts",
    "db:purge-deleted": "tsx --conditions=react-server scripts/purge-soft-deleted.ts",
    "admin:log-digest": "tsx --conditions=react-server scripts/send-admin-log-digest.ts",
    "assets:migrate-content-images": "tsx --conditions=react-server --env-file=.env.local scripts/migrate-content-images-to-asset-bucket.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@react-pdf/renderer": "^4.5.1",
    "@uiw/react-codemirror": "^4.25.11",
    "codemirror": "^6.0.2",
    "gray-matter": "^4.0.3",
    "next": "^16.2.9",
    "openai": "^4.104.0",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unist-util-visit": "^5.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
